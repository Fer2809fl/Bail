# URL pública del backend. El WebView del HTML hace fetch a esta URL.
# Importante: WhatsApp bloquea http:// en producción; usá HTTPS (o un túnel
# tipo ngrok/cloudflared para pruebas locales).
API_HOST=localhost:3001
API_BASE=http://localhost:3001

# Secreto para firmar JWT. CAMBIALO en producción.
JWT_SECRET=cambia-esto-por-algo-aleatorio-largo

# Dónde guardar la BD SQLite
DB_PATH=./scores.db

# Puerto del servidor Express
PORT=3001
